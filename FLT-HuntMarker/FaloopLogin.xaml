<Window x:Class="FLT_HuntMarker.FaloopLogin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Faloop Login" Width="320" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="10">
        <TextBlock Text="Faloop username" />
        <TextBox x:Name="textUsername" Margin="0,2,0,8" />
        <TextBlock Text="Password" />
        <PasswordBox x:Name="textPassword" Margin="0,2,0,8" />
        <TextBlock Text="Session ID (optional, from Faloop app)" />
        <PasswordBox x:Name="textSession" Margin="0,2,0,2" />
        <TextBlock FontSize="10" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Faloop app : F12 &gt; Network &gt; WS &gt; socket.io &gt; Messages, value of 40{&quot;sessionid&quot;:...} after reload. Used before id / pw login." />
        <CheckBox x:Name="checkboxRemember" Content="Remember (encrypted for this Windows user)" IsChecked="True" Margin="0,0,0,8" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Login" Width="70" IsDefault="True" Click="buttonLogin_Click" />
            <Button Content="Cancel" Width="70" Margin="5,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
